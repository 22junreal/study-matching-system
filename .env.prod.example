# Copy to .env.prod. Use dedicated production credentials, not local values.
POSTGRES_DB=study_matching
POSTGRES_USER=study_user
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32 (Base64 of at least 32 random bytes).
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600
# Comma-separated exact frontend origins, e.g. https://study.example.com
CORS_ALLOWED_ORIGINS=

# Both the container listening port and the host port. Use 18080 for local checks.
PORT=8080
# Keep loopback for a reverse proxy on the same host.
BACKEND_BIND_ADDRESS=127.0.0.1

# For infra/compose.edge.yml: use a real domain and leave TLS_MODE empty for public ACME TLS.
SITE_ADDRESS=
TLS_MODE=
EDGE_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
