# Only the private Caddy container can reach this service from the internet.
# Caddy overwrites X-Study-Client-IP; never publish gateway:80 on the host.
map $http_x_study_client_ip $rate_key {
    "" $binary_remote_addr;
    default $http_x_study_client_ip;
}
limit_req_zone $rate_key zone=api:10m rate=30r/s;
limit_req_zone $rate_key zone=auth:10m rate=5r/m;
log_format safe_json escape=json '{"time":"$time_iso8601","method":"$request_method","path":"$uri","status":$status,"duration":$request_time,"requestId":"$upstream_http_x_request_id","edgeRequestId":"$request_id","limit":"$limit_req_status"}';
server {
    listen 80;
    server_tokens off;
    client_max_body_size 64k;
    access_log /dev/stdout safe_json;
    # Nginx error logs can contain the raw request line (including query secrets).
    error_log /dev/stderr crit;
    limit_req_status 429;
    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/json;
        add_header Retry-After 12 always;
        add_header X-Request-ID $request_id always;
        return 429 '{"code":"RATE_LIMITED","status":429,"message":"Too many requests","timestamp":"$time_iso8601"}';
    }
    location ~ ^/api/auth/(login|register|refresh|logout)$ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://backend:${PORT};
        proxy_set_header Host $host;
    }
    location / {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://backend:${PORT};
        proxy_set_header Host $host;
    }
}
