# Local development only. For production use .env.prod.example and infra/compose.prod.yml.
# Used when running the backend on the host (IntelliJ / bootRun).
# Keep these credentials in sync with POSTGRES_USER / POSTGRES_PASSWORD below.
DB_URL=jdbc:postgresql://localhost:5432/study_matching
DB_USERNAME=study_user
DB_PASSWORD=your_local_database_password

# Docker Compose uses these credentials for both PostgreSQL and the backend.
# The backend container always connects to postgres:5432, not localhost.
POSTGRES_DB=study_matching
POSTGRES_USER=study_user
POSTGRES_PASSWORD=your_local_database_password

# Generate a local secret with: openssl rand -base64 32
# Replace this placeholder before starting the backend.
JWT_SECRET=your_base64_encoded_jwt_secret

JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600
# Host port for Docker Compose; the backend container listens on port 8080.
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
